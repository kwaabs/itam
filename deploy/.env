# Copy to .env and adjust. docker compose reads this automatically.
# Image tags are pinned in docker-compose.yml (override there, not here).
# This file is runtime configuration only.

# All host-exposed ports live in the 5600-5620 range (no defaults like 5432/6379).

# --- Postgres ---
# `postgres` is the bootstrap superuser (used only by goose migrations).
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5600

# Least-privilege login roles created by deploy/initdb (bootstrap secrets:
# the DB connection passwords must stay in env). The API runs as itam_app and
# GoTrue runs as supabase_auth_admin.
ITAM_DB_PASSWORD=itam_app_dev_pw
AUTH_DB_PASSWORD=auth_admin_dev_pw

# --- Valkey / NATS ---
REDIS_PORT=5601
NATS_PORT=5602
NATS_MONITOR_PORT=5603

# --- Object storage (RustFS, S3-compatible) ---
S3_PORT=5604
S3_BUCKET=itam
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# --- Auth (GoTrue) ---
# IMPORTANT: must be >= 32 chars and identical for GoTrue and the API.
GOTRUE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
GOTRUE_PORT=5606
GOTRUE_DISABLE_SIGNUP=false
SITE_URL=http://localhost:5608

# Azure AD / OIDC (optional - set AZURE_ENABLED=true and fill in to enable SSO)
AZURE_ENABLED=false
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
AZURE_REDIRECT_URI=http://localhost:5606/callback

# --- Bootstrap admin (granted the admin role on first login) ---
ADMIN_EMAIL=admin@itam.local
ADMIN_PASSWORD=admin12345

# --- App ---
API_PORT=5607
WEB_PORT=5608
CORS_ORIGINS=http://localhost:5608
DEBUG=true
PUBLIC_API_URL=http://localhost:5607
PUBLIC_GOTRUE_URL=http://localhost:5606
