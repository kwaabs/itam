# Copy to .env and adjust. docker compose reads this automatically.
# Image tags are pinned in docker-compose.yml (override there, not here).
# This file is runtime configuration only.

# All host-exposed ports live in the 5600-5620 range (no defaults like 5432/6379).

# --- Postgres ---
# `postgres` is the bootstrap superuser (used only by goose migrations).
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5600

# Least-privilege login role created by deploy/initdb (bootstrap secret: the
# DB connection password must stay in env). The API runs as itam_app.
ITAM_DB_PASSWORD=itam_app_dev_pw

# --- Valkey / NATS ---
REDIS_PORT=5601
NATS_PORT=5602
NATS_MONITOR_PORT=5603

# --- Object storage (RustFS, S3-compatible) ---
S3_PORT=5604
S3_BUCKET=itam
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin

# --- Auth ---
# Signs/verifies the API's own access tokens (local login + Azure SSO).
# IMPORTANT: must be >= 32 chars.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Azure AD (Entra ID) SSO is configured through the app itself (Admin → SSO),
# not env vars - client id/secret/tenant are stored in the database (the
# secret Vault-encrypted) and editable at runtime with no redeploy.

# --- Bootstrap admin (granted the admin role on first login) ---
ADMIN_EMAIL=admin@itam.local
ADMIN_PASSWORD=admin12345

# --- App ---
API_PORT=5607
WEB_PORT=5608
CORS_ORIGINS=http://localhost:5608
DEBUG=true
PUBLIC_API_URL=http://localhost:5607
