# Production template. Copy to .env on the server and fill in every
# CHANGE_ME value before `docker compose up -d`. docker compose reads
# `.env` automatically — do not commit the filled-in file.
#
# Image tags are pinned in docker-compose.yml (override there, not here).

# Replace with your real, publicly reachable domain(s) before filling in the
# URL fields below. If web and API are on different subdomains, adjust
# accordingly (e.g. app.example.com / api.example.com / auth.example.com).
#   DOMAIN=itam.example.com

# --- Postgres ---
# `supabase_admin` is required by the supabase/postgres image's own
# bootstrap (migrate.sh hardcodes it) - do not rename this role.
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_-base64_32
POSTGRES_DB=postgres
POSTGRES_PORT=5600

# Least-privilege login roles created by deploy/initdb. The API runs as
# itam_app and GoTrue runs as supabase_auth_admin - both need real secrets.
ITAM_DB_PASSWORD=CHANGE_ME_openssl_rand_-base64_32
AUTH_DB_PASSWORD=CHANGE_ME_openssl_rand_-base64_32

# --- Valkey / NATS ---
REDIS_PORT=5601
NATS_PORT=5602
NATS_MONITOR_PORT=5603

# --- Object storage (RustFS, S3-compatible) ---
S3_PORT=5604
S3_BUCKET=itam
S3_ACCESS_KEY=CHANGE_ME_openssl_rand_-hex_16
S3_SECRET_KEY=CHANGE_ME_openssl_rand_-base64_32

# --- Auth (GoTrue) ---
# Must be >= 32 chars and identical for GoTrue and the API.
GOTRUE_JWT_SECRET=CHANGE_ME_openssl_rand_-base64_48
GOTRUE_PORT=5606
# Turn off open self-signup once your admin/staff accounts exist, unless you
# want the public to be able to register.
GOTRUE_DISABLE_SIGNUP=true
SITE_URL=https://itam.example.com

# Azure AD / OIDC via GoTrue (optional - set AZURE_ENABLED=true and fill in)
# Entra redirect URI must be the GoTrue callback below, registered exactly
# as-is in your Entra app registration.
AZURE_ENABLED=false
AZURE_CLIENT_ID=CHANGE_ME
AZURE_CLIENT_SECRET=CHANGE_ME
AZURE_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
AZURE_REDIRECT_URI=https://auth.itam.example.com/callback
# Every origin that legitimately calls back into GoTrue after OAuth: the web
# app, the Flutter web build (if hosted), and the Android deep link scheme.
GOTRUE_URI_ALLOW_LIST=https://itam.example.com,itam://sso-callback

# --- Bootstrap admin (granted the admin role on first login) ---
ADMIN_EMAIL=CHANGE_ME_you@example.com
ADMIN_PASSWORD=CHANGE_ME_openssl_rand_-base64_24

# --- App ---
API_PORT=5607
WEB_PORT=5608
# Real origins only - no localhost, no wildcards.
CORS_ORIGINS=https://itam.example.com
DEBUG=false
# Must be reachable from the *browser*, not just from other containers -
# use your public API/auth hostnames, fronted by TLS (reverse proxy/LB).
PUBLIC_API_URL=https://api.itam.example.com
PUBLIC_GOTRUE_URL=https://auth.itam.example.com
